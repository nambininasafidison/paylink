{
  "$schema": "https://json.schemastore.org/tsconfig",
  "$comment": "Shared compiler options for every v2 TypeScript package (PAYLINK-V2-SPEC §4.1, CONTRIBUTING.md §5). Packages extend this file and add their own include, lib and types. Sources import siblings with explicit .ts extensions; tsc rewrites them to .js on emit, and Node 22.18+ can run the sources directly (erasable syntax only).",
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "customConditions": ["@paylink/source"],
    "resolveJsonModule": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "forceConsistentCasingInFileNames": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "newLine": "lf",
    "skipLibCheck": true,
    "types": []
  }
}
