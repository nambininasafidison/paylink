{
  "name": "@paylink/api-contract",
  "version": "0.1.0",
  "private": true,
  "description": "The public contract of the PayPal edition's API (apps/api): request and response types of every route, problem codes and the enumerations the web edition shows (PayPal statuses, situations, proposals). Types and constants only, no dependency, so apps/web imports it without pulling server code.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nambininasafidison/paylink.git",
    "directory": "packages/api-contract"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@paylink/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@paylink/eslint-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
