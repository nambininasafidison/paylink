# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Solidity (forge fmt: tab_width = 4, line_length = 120)
[*.sol]
indent_size = 4
max_line_length = 120

[*.{py,toml}]
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab

# Frozen v1 (Arc Microgrants, tag arc-microgrants-v1) and generated or vendored
# files must stay byte-identical. Some of them deliberately lack a final newline
# (verify/PayLink.standard-input.json, web/ethers.umd.min.js), so editors must not
# normalise them on save.
[{contracts/PayLink.sol,web/**,verify/**,scripts/compile.js,scripts/deploy.js,test/paylink.test.js,package.json,package-lock.json,pnpm-lock.yaml,protocol/lib/**,scripts/toolchain/requirements-slither.txt}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
max_line_length = unset
