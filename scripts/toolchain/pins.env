# SPDX-License-Identifier: MIT
#
# PayLink v2 toolchain pins: the single source of truth for tool versions and
# artifact digests used outside the JS lockfile.
#
# Consumers
#   scripts/bootstrap-sandbox.sh         sandbox install and verification
#   scripts/toolchain/vendor-forge-std.sh  vendored forge-std sync and check
#   CI (.github/workflows/*)             grep -E '^PAYLINK_[A-Z0-9_]+=' scripts/toolchain/pins.env >> "$GITHUB_ENV"
#
# Format: comment lines and plain PAYLINK_*=value lines only. No quotes, no
# spaces, no shell expansion, so the same file can be sourced by bash and
# filtered into a GitHub Actions env file.
#
# Provenance (all verified 2026-10-05; see docs/adr/0012-toolchain-pinning-and-vendoring.md)
#   Foundry tarball sha256: trust-on-first-use, identical across two downloads
#     taken about an hour apart. The release carries a GitHub build-provenance
#     attestation; verify it where Sigstore is reachable (CI) with:
#       gh attestation verify foundry_v1.8.5_linux_amd64.tar.gz --repo foundry-rs/foundry
#   solc sha256 and keccak256: equal to the official solc-bin
#     linux-amd64/list.json entry for 0.8.30+commit.73712a01.
#   forge-std: git commit fetched over the git protocol; the commit hash is
#     checked against the v1.17.0 tag, and the exported tree is pinned by
#     the sha256 of its manifest.

# gitleaks (secret scanning over the git history; .github/workflows/supply-chain.yml, .gitleaks.toml).
# sha256 from the release's gitleaks_8.28.0_checksums.txt, checked against a download on 2026-10-08.
PAYLINK_GITLEAKS_VERSION=8.28.0
PAYLINK_GITLEAKS_LINUX_X64_URL=https://github.com/gitleaks/gitleaks/releases/download/v8.28.0/gitleaks_8.28.0_linux_x64.tar.gz
PAYLINK_GITLEAKS_LINUX_X64_SHA256=a65b5253807a68ac0cafa4414031fd740aeb55f54fb7e55f386acb52e6a840eb

# Runtime and package manager (.nvmrc carries the same Node version)
PAYLINK_NODE_VERSION=22.22.0
PAYLINK_NODE_MIN_VERSION=22.18.0
PAYLINK_PNPM_VERSION=10.28.0

# Foundry (forge, cast, anvil, chisel, plus solar, which ships in the same tarball)
PAYLINK_FOUNDRY_VERSION=1.8.5
PAYLINK_FOUNDRY_COMMIT=51a52c59cffd940f76eddd0b4bb1791aa4b5ac7f
PAYLINK_FOUNDRY_LINUX_AMD64_URL=https://github.com/foundry-rs/foundry/releases/download/v1.8.5/foundry_v1.8.5_linux_amd64.tar.gz
PAYLINK_FOUNDRY_LINUX_AMD64_SHA256=6c66ffcc55fa4249197721baa3098bc208014ea1d8aa04b2ed50ac6bccffb226

# Solidity compiler (static build; svm and solc-select mirrors are blocked in the sandbox)
PAYLINK_SOLC_VERSION=0.8.30
PAYLINK_SOLC_LONG_VERSION=0.8.30+commit.73712a01
PAYLINK_SOLC_LINUX_AMD64_URL=https://github.com/ethereum/solidity/releases/download/v0.8.30/solc-static-linux
PAYLINK_SOLC_LINUX_AMD64_SHA256=f3e987dc6ecebd4bd350c48edcbc320b46cf9e3109bd3fc3d88f1acaf4c428f7
PAYLINK_SOLC_LINUX_AMD64_KECCAK256=0xc47307cc6d212f7d86af1ad07800f9ed4715454a1c327a7258e62d769ec8bdc1

# Static analysis (the full closure is hash-locked in requirements-slither.txt)
PAYLINK_PYTHON_MIN_VERSION=3.10
PAYLINK_SLITHER_VERSION=0.11.6
PAYLINK_CRYTIC_COMPILE_VERSION=0.4.2
PAYLINK_SOLC_SELECT_VERSION=1.2.0

# forge-std, vendored under protocol/lib/forge-std (subset: src/, licences, package.json)
PAYLINK_FORGE_STD_REPO=https://github.com/foundry-rs/forge-std.git
PAYLINK_FORGE_STD_TAG=v1.17.0
PAYLINK_FORGE_STD_COMMIT=f3dae6e6ee381f25eb6a246f7da9b85c91a68219
PAYLINK_FORGE_STD_TREE=1b681a9fd4f2eb68670e529082b158903abde81e
PAYLINK_FORGE_STD_MANIFEST_SHA256=73d6f0e210a00e1f0239b7f7ba39dd1d83349b741ba3b221198bb316465844f2

# OpenZeppelin Contracts. Informational only: the authoritative pin is
# protocol/package.json (exact version) plus pnpm-lock.yaml (sha512 integrity).
PAYLINK_OPENZEPPELIN_CONTRACTS_VERSION=5.3.0

# Property tools (PAYLINK-V2-SPEC §4.1: nightly evidence, not on the PR critical path). Downloaded from the
# projects' GitHub releases on 2026-10-07; sha256 trust-on-first-use. Install and run: protocol/audit/properties.md.
PAYLINK_ECHIDNA_VERSION=2.2.7
PAYLINK_ECHIDNA_LINUX_AMD64_URL=https://github.com/crytic/echidna/releases/download/v2.2.7/echidna-2.2.7-x86_64-linux.tar.gz
PAYLINK_ECHIDNA_LINUX_AMD64_SHA256=d9f8c2e829cc35a4077f8c139863c9087a038262639febd1dcc69d93b79aa314
PAYLINK_MEDUSA_VERSION=1.3.1
PAYLINK_MEDUSA_LINUX_AMD64_URL=https://github.com/crytic/medusa/releases/download/v1.3.1/medusa-linux-x64.tar.gz
PAYLINK_MEDUSA_LINUX_AMD64_SHA256=eeeb1ebd094e8af139e59eb5ecb0b2d20d5ddcd8a913673a3472c475e2009d30
PAYLINK_HALMOS_VERSION=0.3.3
